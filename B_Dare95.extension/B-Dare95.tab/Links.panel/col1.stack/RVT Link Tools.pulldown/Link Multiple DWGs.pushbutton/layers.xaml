<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Specify Layers" Width="420" Height="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" FontFamily="Segoe UI" FontSize="12">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="Specify Layers" Style="{StaticResource Title}" FontSize="15"/>
      <TextBlock x:Name="FileText" Style="{StaticResource Sub}" FontSize="11" Margin="0,2,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource MutedBrush}"
            BorderThickness="1" CornerRadius="6">
      <Grid>
        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                 CaretBrush="{StaticResource AccentBrush}" Padding="8,6" FontSize="12"/>
        <TextBlock x:Name="SearchHint" Text="Search layers..." Style="{StaticResource Hint}" Margin="10,0,0,0"/>
      </Grid>
    </Border>

    <DockPanel Grid.Row="2" Margin="0,8,0,6" LastChildFill="False">
      <Button x:Name="AllBtn" Content="Select All" Style="{StaticResource GhostBtn}" FontSize="11" Margin="0,0,12,0"/>
      <Button x:Name="NoneBtn" Content="Clear" Style="{StaticResource GhostBtn}" FontSize="11"/>
      <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{StaticResource SubtextBrush}" FontSize="11"
                 VerticalAlignment="Center"/>
    </DockPanel>

    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10,8">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="LayerPanel" Margin="0,0,4,0"/>
      </ScrollViewer>
    </Border>

    <DockPanel Grid.Row="4" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource Btn}" Width="84" Margin="0,0,8,0"/>
        <Button x:Name="OkBtn" Content="OK" Style="{StaticResource AccentBtn}" Width="84"/>
      </StackPanel>
      <TextBlock Style="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center"
                 Text="Only the checked layers are linked."/>
    </DockPanel>
  </Grid>
</Window>
