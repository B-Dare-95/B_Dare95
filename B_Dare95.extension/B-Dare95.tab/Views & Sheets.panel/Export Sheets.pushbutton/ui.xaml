<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Sheets" Width="1580" Height="900" MinWidth="1300" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12">
  <Window.Resources>

    <!-- ===== Dropdowns (dark) ===== -->
    <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MutedBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource MutedBrush}" BorderThickness="1" CornerRadius="4">
                      <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource SubtextBrush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBrush}"/>
                        <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource MutedBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="9,0,26,0" VerticalAlignment="Center"/>
              <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide" IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource MutedBrush}" BorderThickness="1" CornerRadius="4" Margin="0,2,0,0" MaxHeight="300" MinWidth="{TemplateBinding ActualWidth}">
                  <ScrollViewer SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True" Margin="3"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Table ===== -->
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource MutedBrush}"/>
          <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ===== Progress bar ===== -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- small grey caption above an option group -->
    <Style x:Key="Cap" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style x:Key="MmBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="60"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Margin" Value="6,0,4,0"/>
    </Style>

    <!-- the three small lists in the File Name pane -->
    <Style x:Key="PaneList" TargetType="ListBox">
      <Setter Property="Background" Value="{StaticResource BgBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="3"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{StaticResource MutedBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ================= HEADER ================= -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="EXPORT SHEETS" Foreground="{StaticResource AccentBrush}" FontSize="17" FontWeight="Bold"/>
        <TextBlock x:Name="StatusText" Style="{StaticResource Sub}" Margin="0,3,0,0" Text=""/>
      </StackPanel>
      <StackPanel x:Name="ProfileBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="Profile" Style="{StaticResource Label}" Margin="0,0,8,0"/>
        <ComboBox x:Name="CmbProfile" Width="220"/>
        <Button x:Name="BtnSaveProfile" Content="Save" Style="{StaticResource Btn}" Margin="8,0,0,0" ToolTip="Save the current settings, file name fields, ticked items and typed names into the chosen profile"/>
        <Button x:Name="BtnNewProfile" Content="New..." Style="{StaticResource Btn}" Margin="6,0,0,0" ToolTip="Save the current settings as a new profile"/>
        <Button x:Name="BtnDeleteProfile" Content="Delete" Style="{StaticResource Btn}" Margin="6,0,0,0"/>
      </StackPanel>
    </Grid>

    <!-- ================= BODY: file name | sheets & views | formats ================= -->
    <Grid Grid.Row="1" x:Name="Body">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="370"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="380"/>
      </Grid.ColumnDefinitions>

      <!-- ===== LEFT: file name ===== -->
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="110"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="90"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="FILE NAME" Style="{StaticResource Section}" Margin="0,0,0,2"/>
            <TextBlock Style="{StaticResource Sub}" FontSize="11" Text="Pick parameters and add them in order. Each field has its own separator."/>
          </StackPanel>

          <!-- available parameters -->
          <Grid Grid.Row="1" Margin="0,0,0,6">
            <TextBox x:Name="TxtParamSearch" Height="28"/>
            <TextBlock x:Name="ParamSearchHint" Text="Search parameters..." Style="{StaticResource Hint}"/>
          </Grid>
          <ListBox Grid.Row="2" x:Name="LstParams" Style="{StaticResource PaneList}" SelectionMode="Extended" ToolTip="Double-click, or select and press Add. Ctrl / Shift selects several."/>
          <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnAddField" Content="Add  &#x25BC;" Style="{StaticResource AccentBtn}" Width="80"/>
            <Grid Grid.Column="1" Margin="8,0,0,0">
              <TextBox x:Name="TxtCustom" Height="30"/>
              <TextBlock x:Name="CustomHint" Text="Custom text, e.g. IFC" Style="{StaticResource Hint}"/>
            </Grid>
            <Button Grid.Column="2" x:Name="BtnAddText" Content="+ Text" Style="{StaticResource Btn}" Margin="6,0,0,0"/>
          </Grid>

          <!-- the fields, in order -->
          <TextBlock Grid.Row="4" Text="FIELDS IN THE FILE NAME (in order)" Style="{StaticResource Cap}" Margin="0,14,0,4"/>
          <ListBox Grid.Row="5" x:Name="LstFields" Style="{StaticResource PaneList}"/>
          <Grid Grid.Row="6" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
              <Button x:Name="BtnFieldUp" Content="&#x25B2;" Style="{StaticResource IconBtn}" ToolTip="Move up"/>
              <Button x:Name="BtnFieldDown" Content="&#x25BC;" Style="{StaticResource IconBtn}" ToolTip="Move down"/>
              <Button x:Name="BtnFieldRemove" Content="Remove" Style="{StaticResource Btn}"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="Separator after" Style="{StaticResource Label}" Margin="8,0,6,0"/>
            <TextBox Grid.Column="3" x:Name="TxtSep" Height="28" FontFamily="Consolas" ToolTip="Text written after the selected field (spaces count). Never written after the last field."/>
          </Grid>

          <!-- whole-name options -->
          <Grid Grid.Row="7" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Text="Prefix" Style="{StaticResource Label}" Margin="0,0,6,0"/>
            <TextBox Grid.Column="1" x:Name="TxtPrefix" Height="26"/>
            <TextBlock Grid.Column="2" Text="Suffix" Style="{StaticResource Label}" Margin="10,0,6,0"/>
            <TextBox Grid.Column="3" x:Name="TxtSuffix" Height="26"/>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="Replace illegal characters  \ / : * ? &quot; &lt; &gt; |  with" Style="{StaticResource Label}" Margin="0,0,6,0"/>
              <TextBox x:Name="TxtReplace" Width="40" Height="26" MaxLength="3" FontFamily="Consolas"/>
            </StackPanel>
          </Grid>
          <CheckBox Grid.Row="8" x:Name="ChkSkipEmpty" Content="Skip empty values (and their separator)" Margin="0,8,0,0"/>
        </Grid>
      </Border>

      <!-- ===== MIDDLE: what to export ===== -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="7" Padding="2">
              <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="TglSheets" Content="Sheets" Width="84" Style="{StaticResource Seg}" IsChecked="True"/>
                <ToggleButton x:Name="TglViews" Content="Views" Width="84" Style="{StaticResource Seg}"/>
              </StackPanel>
            </Border>
            <ComboBox Grid.Column="1" x:Name="CmbSet" Width="210" Margin="10,0,0,0" ToolTip="Show only the sheets / views of a View/Sheet Set saved in this model"/>
            <Grid Grid.Column="2" Margin="10,0,0,0">
              <TextBox x:Name="TxtSearch" Height="28"/>
              <TextBlock x:Name="SearchHint" Text="Search number or name..." Style="{StaticResource Hint}"/>
            </Grid>
          </Grid>

          <Grid Grid.Row="1" Margin="0,0,0,8">
            <WrapPanel>
              <Button x:Name="BtnTickShown" Content="Tick all shown" Style="{StaticResource GhostBtn}" Margin="0,0,16,0"/>
              <Button x:Name="BtnUntickShown" Content="Untick all shown" Style="{StaticResource GhostBtn}" Margin="0,0,16,0"/>
              <Button x:Name="BtnTickSelected" Content="Tick selected rows" Style="{StaticResource GhostBtn}" Margin="0,0,16,0" ToolTip="Select rows with Shift / Ctrl, then tick them all at once (or press Space)"/>
              <Button x:Name="BtnResetNames" Content="Reset typed names" Style="{StaticResource GhostBtn}" ToolTip="Names you typed by hand are shown in yellow and kept. This puts the File Name pane's name back."/>
            </WrapPanel>
            <TextBlock x:Name="CountText" Style="{StaticResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>

          <DataGrid Grid.Row="2" x:Name="Grid"
                    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    CanUserResizeRows="False" CanUserSortColumns="True" CanUserReorderColumns="False"
                    SelectionMode="Extended" SelectionUnit="FullRow"
                    HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="26"
                    Background="Transparent" RowBackground="#262626" AlternatingRowBackground="#2C2C2C"
                    Foreground="{StaticResource TextBrush}" BorderThickness="0"
                    GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#393939"
                    EnableRowVirtualization="True">
            <DataGrid.Resources>
              <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
              </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="36" CanUserSort="True" SortMemberPath="Pick">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Pick, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Number" Binding="{Binding Number}" IsReadOnly="True" Width="100" FontFamily="Consolas" SortMemberPath="SortKey"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
              <DataGridTextColumn Header="File name  (double-click to type)" Binding="{Binding FileName, UpdateSourceTrigger=LostFocus}" Width="3*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="ToolTip" Value="{Binding FileName}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Custom}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="150">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="ToolTip" Value="{Binding Status}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding State}" Value="ok">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="fail">
                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="busy">
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- ===== RIGHT: formats, settings, output ===== -->
      <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,14,12">
          <StackPanel>

            <!-- ===== Output ===== -->
            <TextBlock Text="SAVE TO" Style="{StaticResource Section}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TxtFolder" Height="28"/>
              <Button Grid.Column="1" x:Name="BtnBrowse" Content="Browse..." Style="{StaticResource Btn}" Margin="6,0,0,0"/>
            </Grid>
            <CheckBox x:Name="ChkSubfolders" Content="A sub-folder per format (\PDF, \DWG)" Margin="0,8,0,2"/>
            <CheckBox x:Name="ChkOverwrite" Content="Overwrite files with the same name"/>
            <CheckBox x:Name="ChkOpenFolder" Content="Open the folder when done"/>

            <TextBlock Text="FORMATS" Style="{StaticResource Section}" Margin="0,20,0,8"/>
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="ChkPdf" Content="PDF" Width="90"/>
              <CheckBox x:Name="ChkDwg" Content="DWG" Width="90"/>
            </StackPanel>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7" Padding="2" Margin="0,14,0,4">
              <UniformGrid Columns="2">
                <ToggleButton x:Name="TabPdf" Content="PDF settings" Style="{StaticResource Seg}" IsChecked="True"/>
                <ToggleButton x:Name="TabCad" Content="DWG settings" Style="{StaticResource Seg}"/>
              </UniformGrid>
            </Border>

            <!-- ===== PDF page ===== -->
            <StackPanel x:Name="PagePdf">
              <TextBlock Text="Output" Style="{StaticResource Cap}"/>
              <RadioButton x:Name="RbSeparate" GroupName="PdfOut" Content="One PDF per sheet / view" IsChecked="True"/>
              <StackPanel x:Name="BackgroundPanel" Margin="26,2,0,6">
                <CheckBox x:Name="ChkBackground" Content="Use Revit's background export" ToolTip="Revit 2025+, sheets only. Revit makes the PDFs in its own background process while you keep working; they arrive in a local temp folder and are renamed and moved."/>
                <TextBlock Style="{StaticResource Sub}" FontSize="11" Margin="26,2,0,0" Text="Sheets only. The PDFs run as one batch while the DWGs export one by one."/>
              </StackPanel>
              <RadioButton x:Name="RbCombine" GroupName="PdfOut" Content="Combine everything into ONE PDF"/>
              <Grid Margin="26,2,0,4">
                <TextBox x:Name="TxtCombinedName" Height="26" FontFamily="Consolas" ToolTip="File name of the combined PDF. Project tokens work here, e.g. {Project Number}, {Export Date}."/>
              </Grid>
              <RadioButton x:Name="RbGroup" GroupName="PdfOut" Content="One combined PDF per value of a parameter"/>
              <Grid Margin="26,2,0,0">
                <ComboBox x:Name="CmbGroupBy" ToolTip="For example Sheet Group, Discipline or Drawing Type: each value becomes one PDF named after it"/>
              </Grid>
              <TextBlock Text="Paper size and orientation always come from each sheet's title block." Style="{StaticResource Sub}" FontSize="11" Margin="0,6,0,0"/>

              <TextBlock Text="Paper placement" Style="{StaticResource Cap}"/>
              <RadioButton x:Name="RbCenter" GroupName="PdfPlace" Content="Center" IsChecked="True"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbOffset" GroupName="PdfPlace" Content="Offset from lower-left    X"/>
                <TextBox x:Name="TxtOffX" Style="{StaticResource MmBox}"/>
                <TextBlock Text="Y" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtOffY" Style="{StaticResource MmBox}"/>
                <TextBlock Text="mm" Style="{StaticResource Label}"/>
              </StackPanel>

              <TextBlock Text="Zoom" Style="{StaticResource Cap}"/>
              <RadioButton x:Name="RbFit" GroupName="PdfZoom" Content="Fit to page" IsChecked="True"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbZoom" GroupName="PdfZoom" Content="Zoom"/>
                <TextBox x:Name="TxtZoom" Style="{StaticResource MmBox}"/>
                <TextBlock Text="% size" Style="{StaticResource Label}"/>
              </StackPanel>

              <TextBlock Text="Hidden line views" Style="{StaticResource Cap}"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbVector" GroupName="PdfHlr" Content="Vector processing" IsChecked="True" Margin="0,2,20,2"/>
                <RadioButton x:Name="RbRaster" GroupName="PdfHlr" Content="Raster processing"/>
              </StackPanel>

              <TextBlock Text="Appearance" Style="{StaticResource Cap}"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Raster quality" Style="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                  <ComboBox x:Name="CmbQuality"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Colours" Style="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                  <ComboBox x:Name="CmbColor"/>
                </StackPanel>
              </Grid>
              <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Export quality (DPI)" Style="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                <ComboBox x:Name="CmbDpi" ToolTip="How finely Revit draws curves and any rasterised areas. Higher is slower and bigger; 300 suits most drawings."/>
                <TextBlock Text="Lower is faster. Check the drawings look right before going below 300." Style="{StaticResource Sub}" FontSize="11" Margin="0,4,0,0"/>
              </StackPanel>

              <TextBlock Text="Options" Style="{StaticResource Cap}"/>
              <CheckBox x:Name="ChkLinksBlue" Content="View links in blue (colour prints only)"/>
              <CheckBox x:Name="ChkHideRef" Content="Hide ref / work planes"/>
              <CheckBox x:Name="ChkHideTags" Content="Hide unreferenced view tags"/>
              <CheckBox x:Name="ChkHideScope" Content="Hide scope boxes"/>
              <CheckBox x:Name="ChkHideCrop" Content="Hide crop boundaries"/>
              <CheckBox x:Name="ChkHalftone" Content="Replace halftone with thin lines"/>
              <CheckBox x:Name="ChkMask" Content="Region edges mask coincident lines"/>
            </StackPanel>

            <!-- ===== DWG page ===== -->
            <StackPanel x:Name="PageCad" Visibility="Collapsed">
              <TextBlock Text="Export setup" Style="{StaticResource Cap}"/>
              <ComboBox x:Name="CmbSetup"/>
              <TextBlock Text="The setups saved in this model (File &gt; Export &gt; CAD Formats &gt; Modify Setup). They hold layers, line weights, colours and units." Style="{StaticResource Sub}" FontSize="11" Margin="0,4,0,0"/>

              <TextBlock Text="AutoCAD version" Style="{StaticResource Cap}"/>
              <ComboBox x:Name="CmbVersion"/>

              <TextBlock Text="Options" Style="{StaticResource Cap}"/>
              <CheckBox x:Name="ChkMerged" Content="One file per sheet (views merged, no xref files)"/>
              <CheckBox x:Name="ChkShared" Content="Use shared coordinates"/>
              <CheckBox x:Name="ChkDeletePcp" Content="Delete the .pcp file Revit writes next to each DWG"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ================= FOOTER ================= -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Value="0"/>
        <DockPanel Margin="0,6,0,0">
          <Button x:Name="BtnOpenLog" DockPanel.Dock="Right" Content="Open timing log" Style="{StaticResource GhostBtn}" Margin="12,0,0,0" IsEnabled="False" ToolTip="Seconds per file for the last export, as a CSV that opens in Excel"/>
          <TextBlock x:Name="ResultText" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </DockPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnStop" Content="Stop" Style="{StaticResource Btn}" Width="90" IsEnabled="False" ToolTip="Stops after the file being exported now"/>
        <Button x:Name="BtnExport" Content="Export" Style="{StaticResource AccentBtn}" Width="130" Margin="8,0,0,0"/>
        <Button x:Name="BtnClose" Content="Close" Style="{StaticResource Btn}" Width="90" Margin="8,0,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
