<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Cleaner - Project Families" Width="1080" SizeToContent="Height" MaxHeight="920"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" FontFamily="Segoe UI">
    <Window.Resources>
<Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
</Style>
<Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Bold"/>
</Style>
<Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
</Style>
<Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
</Style>
<Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
</Style>
<Style x:Key="Input" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>
<Style x:Key="Pill" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="MinWidth" Value="40"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,4">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource BgBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>
<Style x:Key="Primary" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource BgBrush}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>
<Style x:Key="Secondary" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource MutedBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="MinWidth" Value="64"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,4">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>
</Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
<TextBlock Text="Family Cleaner" Style="{StaticResource H1}" Margin="0,0,0,4"/>
<TextBlock x:Name="Subtitle" Style="{StaticResource Hint}" Margin="0,0,0,14"/>

<Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="400"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Margin="0,0,12,0">
<Border Style="{StaticResource Card}" Margin="0">
    <StackPanel>
        <DockPanel Margin="0,0,0,8">
            <Button x:Name="BtnPick" DockPanel.Dock="Right" Content="Pick from Model" Style="{StaticResource Secondary}"
                    ToolTip="Pick placed instances in the model: their families become the ones to clean"/>
            <TextBlock Text="Families to clean, by category" Style="{StaticResource Label}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="PickNote" Style="{StaticResource Hint}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"
                   Visibility="Collapsed"/>
        <DockPanel Margin="0,0,0,8">
            <Button x:Name="BtnNone" DockPanel.Dock="Right" Content="None" Style="{StaticResource Secondary}" Margin="6,0,0,0"/>
            <Button x:Name="BtnAll" DockPanel.Dock="Right" Content="All" Style="{StaticResource Secondary}"/>
            <CheckBox x:Name="ChkInspect" DockPanel.Dock="Right" Content="Inspection Mode" Margin="10,0,10,0"
                      VerticalAlignment="Center"
                      ToolTip="Change nothing: run with every setting on and report what a full clean would remove"/>
            <Grid>
                <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Height="30"/>
                <TextBlock x:Name="SearchHint" Text="Search families or categories..." Foreground="{StaticResource PlaceholderBrush}" FontSize="12"
                           Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </DockPanel>
        <ScrollViewer Height="560" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ListPanel"/>
        </ScrollViewer>
        <TextBlock x:Name="CountText" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
    </StackPanel>
</Border>
</StackPanel>
    <StackPanel Grid.Column="1">
        <DockPanel Margin="2,0,0,8">
            <TextBlock Text="Settings" Style="{StaticResource Label}" VerticalAlignment="Center"/>
            <TextBlock x:Name="InspectNote" Text="Inspection Mode: every setting is on" Foreground="{StaticResource AccentBrush}"
                       FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
        </DockPanel>
        <StackPanel x:Name="SettingsPanel">
<Border Style="{StaticResource Card}">
    <StackPanel>
        <TextBlock Text="Nested levels to clean" Style="{StaticResource Label}"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
            <ToggleButton x:Name="Depth1" Content="1" Style="{StaticResource Pill}"/>
            <ToggleButton x:Name="Depth2" Content="2" Style="{StaticResource Pill}"/>
            <ToggleButton x:Name="Depth3" Content="3" Style="{StaticResource Pill}"/>
            <ToggleButton x:Name="Depth4" Content="4" IsChecked="True" Style="{StaticResource Pill}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Level 1 is the families nested in the family being cleaned. Unused nested families are deleted at any level; this sets how deep the used ones get cleaned themselves. Deeper takes longer."/>
    </StackPanel>
</Border>
<Border Style="{StaticResource Card}">
    <StackPanel>
        <TextBlock Text="What to clean" Style="{StaticResource Label}"/>
        <CheckBox x:Name="ChkPurge" IsChecked="True" Margin="0,8,0,0"
                  Content="Purge unused content (nested families, types, materials, patterns, styles)"/>
        <CheckBox x:Name="ChkParams" IsChecked="True" Margin="0,8,0,0"
                  Content="Remove family parameters nothing uses"/>
        <StackPanel Orientation="Horizontal" Margin="24,6,0,0">
            <ToggleButton x:Name="ScopeAll" Content="All groups" IsChecked="True" Style="{StaticResource Pill}"/>
            <ToggleButton x:Name="ScopeJunk" Content="Identity Data, IFC, General only" Style="{StaticResource Pill}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="24,4,0,0"
                   Text="Kept when used by a formula, a dimension or array label, an element, a reporting relation or the parent family. Tag/annotation families keep all theirs; shared ones follow the project option."/>
        <CheckBox x:Name="ChkCad" Margin="0,10,0,0"
                  Content="Delete CAD imports and PDFs inside the families"/>
        <TextBlock Style="{StaticResource Hint}" Margin="24,2,0,0"
                   Text="Off by default: a CAD drawing inside a family is often its symbol."/>
    </StackPanel>
</Border>

<Border Style="{StaticResource Card}">
    <StackPanel>
        <TextBlock Text="Project options" Style="{StaticResource Label}"/>
        <CheckBox x:Name="ChkShared" Margin="0,8,0,0"
                  Content="Also remove unused shared parameters (top-level families only)"/>
        <TextBlock Style="{StaticResource Hint}" Margin="24,2,0,0"
                   Text="Only when no schedule, view filter, project parameter or placed copy in this project uses them. Tags and other projects using the same family can't be checked."/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox x:Name="ChkSaveEvery" Content="Save the model every" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtEvery" Text="10" Width="44" Height="26" Margin="8,0,8,0" Style="{StaticResource Input}"/>
            <TextBlock Text="families" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="24,2,0,0"
                   Text="Protects a long run against a crash, but closing without saving no longer throws the run away."/>
    </StackPanel>
</Border>
</StackPanel>
    </StackPanel>
</Grid>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
    <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource Secondary}" Height="34" MinWidth="88" Margin="0,0,10,0"/>
    <Button x:Name="BtnRun" Content="Clean" Style="{StaticResource Primary}"/>
</StackPanel>
</StackPanel>
    </ScrollViewer>
</Window>
