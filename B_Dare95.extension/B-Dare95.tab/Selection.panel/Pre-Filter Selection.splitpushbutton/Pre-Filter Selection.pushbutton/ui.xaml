<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Choose Categories"
    Width="340" MinHeight="120" MaxHeight="680"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="{DynamicResource BgBrush}"
    Foreground="{DynamicResource TextBrush}"
    FontFamily="Segoe UI"
    FontSize="13">

    <Border Padding="16" Background="{StaticResource BgBrush}">
        <StackPanel>

            <TextBlock x:Name="HeaderText" Text="Choose Categories" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

            <!-- Mode switch -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="3" Margin="0,0,0,6">
                <UniformGrid Columns="2">
                    <ToggleButton x:Name="ModeActive" Content="This model" Style="{StaticResource Seg}"/>
                    <ToggleButton x:Name="ModeLinked" Content="Linked models" Style="{StaticResource Seg}"/>
                </UniformGrid>
            </Border>
            <TextBlock x:Name="SubHeader" FontSize="11" Style="{StaticResource Sub}" Margin="2,0,0,10"/>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Margin="0,0,0,10"
                    BorderBrush="{StaticResource MutedBrush}" BorderThickness="1">
                <Grid>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             CaretBrush="{StaticResource AccentBrush}" Padding="8,6" FontSize="12"/>
                    <TextBlock x:Name="SearchHint" Text="Search categories..." Style="{StaticResource Hint}"
                               FontSize="12" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <CheckBox x:Name="ChkExcept" Content="Everything except the checked categories"
                      FontSize="12" Margin="0,0,0,8"
                      ToolTip="Select everything in the box (or everything you click) except the checked categories"/>

            <DockPanel Margin="0,0,0,8" LastChildFill="False">
                <Button x:Name="SelectAllBtn" Content="Select All" Style="{StaticResource GhostBtn}" FontSize="11"
                        DockPanel.Dock="Left" Margin="0,0,12,0"/>
                <Button x:Name="ClearBtn" Content="Clear" Style="{StaticResource GhostBtn}" FontSize="11"
                        DockPanel.Dock="Left"/>
                <TextBlock x:Name="CountLabel" Foreground="{StaticResource SubtextBrush}" FontSize="11"
                           VerticalAlignment="Center" DockPanel.Dock="Right"/>
            </DockPanel>

            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                <Grid>
                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel x:Name="CategoryPanel"/>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Sub}" FontSize="12"
                               Margin="2,6" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Button x:Name="ConfirmBtn" Content="Make A Selection"
                    Style="{StaticResource AccentBtn}" Height="36" FontSize="13" IsEnabled="False"/>

        </StackPanel>
    </Border>
</Window>
